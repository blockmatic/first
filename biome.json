{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/build",
      "!**/.turbo",
      "!**/.source",
      "!**/.vercel",
      "!**/.cache",
      "!**/coverage",
      "!**/test-results",
      "!**/next-env.d.ts",
      "!pnpm-lock.yaml",
      "!.pnp.js",
      "!.DS_Store",
      "!**/.agents/skills"
    ],
    "maxSize": 1048576
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "none"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConsole": {
          "level": "error"
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "complexity": {
        "useOptionalChain": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "const", "scope": "global" },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        },
        "noEnum": "error",
        "noUselessElse": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "useTemplate": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lodash-es": "Use per-function imports: lodash-es/<fn> (e.g., lodash-es/isEmpty).",
              "@repo/ui": "Use subpath imports: @repo/ui/components/*, @repo/ui/lib/utils."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/lib/env.ts", "**/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**/*.mjs",
        "**/scripts/**/*.ts",
        "**/packages/validate/**",
        "**/*.test.ts",
        "**/*.config.{js,mjs,ts}",
        "**/mdx-components.tsx",
        "**/packages/ui/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
